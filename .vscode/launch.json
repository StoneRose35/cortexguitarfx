{
    "configurations": [
        {
            "name": "Launch built-in server",
            "type": "php",
            "request": "launch",
            "runtimeArgs": [
                "-S",
                "localhost:8000",
                "-t",
                "./tools"
            ],
            "runtimeExecutable": "php",
            "port": 9003,
            "serverReadyAction": {
                "action": "openExternally"
            }
        },
        {
            "name": "Python: Aktuelle Datei",
            "type": "python",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "args": [],
            "cwd": "${fileDirname}"
        },
        {
            "cwd": "${workspaceFolder}",
            "executable": "./out/ppfx_daisyseed.elf",
            "name": "Program&Debug with ST-Util",
            "request": "attach",
            "interface": "swd",
            "preLaunchTask": "Build and program using make",
            "type": "cortex-debug",
            "device": "STM32H74x_H75x",
            "showDevDebugOutput": "parsed",
            "servertype": "stlink",
            "svdFile": "STM32H750x.svd",
        },
        {
            "cwd": "${workspaceFolder}",
            "executable": "./out/ppfx_daisyseed.elf",
