{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build using make",
            "type": "shell",
            "command": "make clean_objs;make -j8 all",
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Main Builder: generates the UF2-Firmware to put onto the Raspberry Pi Pico"
        },
        {
            "label": "Build tests",
            "type": "shell",
            "command": "make tests",
            "group": "build"
        },
        {
            "type": "cppbuild",
            "label": "C/C++: gcc-9 Aktive Datei kompilieren",
            "command": "/usr/bin/gcc-9",
            "args": [
                "-I./../Inc",
                "-fdiagnostics-color=always",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Vom Debugger generierte Aufgabe."
        },
        {
            "type": "cppbuild",
            "label": "compile offline audio processor",
            "command": "g++",
            "args": [
                "-I./Inc",
                "-I./Tests/inc",
                "-fdiagnostics-color=always",
                "-g",
                "./Src/pipicofx/FxProgram.cpp",
                "./Src/pipicofx/FxProgramLoader.cpp",
                "./Src/pipicofx/FxProgramParameter.cpp",
                "./Src/pipicofx/0*.cpp",
                "./Src/pipicofx/*AudioProcessor.cpp",
                "out/*.o",
                "./Tests/processThroughFxProgram.cpp", 
                "-o",
                "./Tests/processThroughFxProgram", "-lm"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "dependsOn": "compile c part for c++ test",
            "detail": "Function to run a given wavefile through a predefined fx program."
        },
        {
            "type": "cppbuild",
            "label": "compile fxprogram integration test",
            "command": "/usr/bin/gcc-9",
            "args": [
                "-I./Inc",
                "-I./Tests/inc",
                "-fdiagnostics-color=always",
                "-g",
                "./Tests/fxprograms_integrationtest.c", "./Src/common/audio/*.c",
                "./Src/common/stringFunctions.c","./Src/pipicofx/fxProgram*.c","./Tests/libs/wavReader.c",
                "./Src/common/math/*.c",
                "-o",
                "./Tests/fxprograms_integrationtest", "-lm"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Function to run a given wavefile through a predefined fx program."
        },
        {
            "type": "cppbuild",
            "label": "compile generateUnitPulseWav",
            "command": "/usr/bin/gcc-9",
            "args": [
                "-I./Inc",
                "-I./Tests/inc",
                "-fdiagnostics-color=always",
                "-g",
                "./Tests/generateUnitPulseWav.c","./Tests/libs/wavReader.c",
                "-o",
                "./Tests/generateUnitPulseWav", "-lm"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Generates a Unit Pulse Wav File"
        },
        {
            "type": "cppbuild",
            "label": "compile bitmap helper",
            "command": "/usr/bin/gcc-9",
            "args": [
                "-I./Inc",
                "-I./Inc/graphics",
                "-I./Tests/inc",
                "-I./Inc/fonts",
                "-fdiagnostics-color=always",
                "-g",
                "./Tests/pipicouitest.c", "./Src/common/graphics/bwgraphics.c", "./Tests/libs/*.c", 
                "-o",
                "./Tests/pipicouitest",
                "-lm"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Rendering OLED display images to Bitmaps."
        },
        {
            "type": "cppbuild",
            "label": "compile audio tests",
            "command": "/usr/bin/gcc-9",
            "args": [
                "-I./Inc",
                "-I./Tests/inc",
                "-fdiagnostics-color=always",
                "-g",
                "./Tests/audioTest.c", "./Src/common/audio/*.c",
                "./Src/common/stringFunctions.c","./Src/pipicofx/fxProgram*.c","./Tests/libs/wavReader.c",
                "./Src/common/math/*.c",
                "-o",
                "./Tests/audioTest", "-lm"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Audio Unit Tests."
        },
        {
            "type": "cppbuild",
            "label": "compile compressor test",
            "command": "/usr/bin/gcc-9",
            "args": [
                "-I./Inc",
                "-I./Tests/inc",
                "-fdiagnostics-color=always",
                "-g",
                "./Tests/compressorTest.c", "./Src/common/audio/*.c","./Src/common/stringFunctions.c","./Src/common/math/*.c","./Tests/libs/wavReader.c",
                "-o",
                "./Tests/compressorTest", "-lm"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Audio Unit Tests."
        },
        {
            "type": "cppbuild",
            "label": "compile C++ tests",
            "command": "/usr/bin/g++",
            "args": [
                "-I./Inc",
                "-I./Inc/RpiPico",
                "-fdiagnostics-color=always",
                "-g",
                "./Tests/cpp_tests.cpp", "./Src/pipicofx/0*.cpp", "./Src/pipicofx/FxProgram*.cpp", "./Src/pipicofx/*AudioProcessor.cpp","./out/*.o",
                "-o",
                "./Tests/cppTests", 
                "-lm"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": "build",
            "dependsOn": "compile c part for c++ test"
        },
        {
            "type": "cppbuild",
            "label": "compile c part for c++ test",
            "command": "/usr/bin/gcc",
            "args": [
                "-I./../Inc",
                "-fdiagnostics-color=always",
                "-g",
                "-c",
                "./../Src/common/audio/*.c","./../Src/common/stringFunctions.c","./../Src/common/math/*.c","./../Src/pipicofx/delayMemoryHandler.c", "./../Tests/libs/wavReader.c"
            ],
            "options": {
                "cwd": "${workspaceFolder}/out"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": "build"
        },
        {
            "type": "cppbuild",
            "label": "compile delay memory handler tests",
            "command": "/usr/bin/g++",
            "args": [
                "-I./Inc",
                "-fdiagnostics-color=always",
                "-fpermissive",
                "-g",
                "./Tests/delayMemoryHandlerTest.cpp", "./Src/pipicofx/delayMemoryHandler.c",
                "-o",
                "./Tests/delayMemoryHandlerTests"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": "build",
            "detail": "Compiles Tests for the delay memory handler, compiles with warning on a 64bit system"
        }
    ]
}