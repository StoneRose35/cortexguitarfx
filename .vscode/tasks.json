{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build using make",
            "type": "shell",
            "command": "make clean_objs; make -j8 all",
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Clean using make",
            "type": "shell",
            "command": "make clean",
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": false
            }
        },
        {
            "label": "Build tests",
            "type": "shell",
            "command": "make tests",
            "group": "build"
        },
        {
            "type": "cppbuild",
            "label": "compile offline audio processor",
            "command": "g++",
            "args": [
                "-I./Inc",
                "-I./Tests/inc",
                "-fdiagnostics-color=always",
                "-g",
                "./Src/pipicofx/FxProgram.cpp",
                "./Src/pipicofx/FxProgramLoader.cpp",
                "./Src/pipicofx/FxProgramParameter.cpp",
                "./Src/pipicofx/0*.cpp",
                "./Src/pipicofx/*AudioProcessor.cpp",
                "out/*.o",
                "./Tests/processThroughFxProgram.cpp", 
                "-o",
                "./Tests/processThroughFxProgram", "-lm"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "dependsOn": "compile c part for c++ test",
            "detail": "Function to run a given wavefile through a predefined fx program."
        },
        {
            "type": "cppbuild",
            "label": "compile generateUnitPulseWav",
            "command": "/usr/bin/gcc-9",
            "args": [
                "-I./Inc",
                "-I./Tests/inc",
                "-fdiagnostics-color=always",
                "-DFLOAT_AUDIO",
                "-g",
                "./Tests/generateUnitPulseWav.c",
                "./Tests/libs/wavReader.c",
                "-o",
                "./Tests/generateUnitPulseWav",
                "-lm"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": "build",
            "detail": "Generates a Unit Pulse Wav File"
        },
        {
            "type": "cppbuild",
            "label": "compile bitmap helper",
            "command": "/usr/bin/gcc-9",
            "args": [
                "-I./Inc",
                "-I./Tests/inc",
                "-fdiagnostics-color=always",
                "-DFLOAT_AUDIO",
                "-g",
                "./Tests/pipicouitest.c",
                "./Src/common/graphics/bwgraphics.c",
                "./Tests/libs/*.c",
                "-o",
                "./Tests/pipicouitest",
                "-lm"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": "build",
            "detail": "Rendering OLED display images to Bitmaps."
        },
        {
            "type": "cppbuild",
            "label": "compile audio tests",
            "command": "/usr/bin/gcc-9",
            "args": [
                "-I./Inc",
                "-I./Tests/inc",
                "-fdiagnostics-color=always",
                "-DFLOAT_AUDIO",
                "-g",
                "./Tests/audioTest.c",
                "./Src/common/audio/*.c",
                "./Src/common/math/*.c",
                "./Src/common/stringFunctions.c",
                "./Src/pipicofx/fxProgram*.c",
                "./Tests/libs/wavReader.c",
                "-o",
                "./Tests/audioTest",
                "-lm"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": "build",
            "detail": "Audio Unit Tests."
        },
        {
            "type": "cppbuild",
            "label": "bin2dfu erstellen",
            "command": "g++",
            "args": [
                "-fdiagnostics-color=always",
                "-I",
                "${workspaceFolder}/Inc",
                "-g",
                "${workspaceFolder}/tools/bins2dfu_src/bin2dfu.cpp",
                "-o",
                "${workspaceFolder}/tools/bins2dfu"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "detail": "Erstellt das Tool bin2dfu."
        },
        {
            "type": "cppbuild",
            "label": "compile c part for c++ test",
            "command": "/usr/bin/gcc",
            "args": [
                "-I./../Inc",
                "-fdiagnostics-color=always",
                "-g",
                "-c",
                "./../Src/common/audio/*.c","./../Src/common/stringFunctions.c","./../Src/common/math/*.c","./../Src/pipicofx/delayMemoryHandler.c", "./../Tests/libs/wavReader.c"
            ],
            "options": {
                "cwd": "${workspaceFolder}/out"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": "build"
        },
        {
            "type": "cppbuild",
            "label": "C/C++: gcc-9 Aktive Datei kompilieren",
            "command": "g++",
            "args": [
                "-fdiagnostics-color=always",
                "-I",
                "${workspaceFolder}/Inc",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "detail": "Vom Debugger generierte Aufgabe."
        }
    ]
}